# Define the OpenAI API key here if you want to use a local .env file for that.
OPENAI_API_KEY=....

# Or the Azure OpenAI API details. 
# To use Entra ID authentication, don't set the API key.
AZURE_OPENAI_API_KEY=....
AZURE_OPENAI_ENDPOINT=....

# Or use OpenRouter. Keep exactly one OPENROUTER_MODEL line uncommented.
# TINY_TROUPE_API_TYPE=openrouter
# OPENROUTER_API_KEY=sk-or-v1-....
# OPENROUTER_MODEL=openai/gpt-5-mini
# OPENROUTER_MODEL=openai/gpt-4o-mini
# TINY_TROUPE_EVALUATOR_MODEL=openai/gpt-5-mini
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# TINY_TROUPE_MAX_COMPLETION_TOKENS=16384

# Optional OpenRouter attribution headers:
# OPENROUTER_SITE_URL=https://your-project.example
# OPENROUTER_APP_NAME=TinyTroupe Research
